# Copia a .env y rellena. Nunca subas .env
# Genera las contraseñas con `openssl rand -hex 24` (evita `$`, que Compose interpreta)

# Puerto local de MySQL; 3306 y 3307 los usan otros proyectos en esta máquina
MYSQL_PUERTO=3308
# Nombre de la base de datos que crea MySQL al arrancar
MYSQL_DATABASE=
# Usuario de la aplicación en MySQL
MYSQL_USER=
# Contraseña del usuario de la aplicación
MYSQL_PASSWORD=
# Contraseña del usuario root de MySQL
MYSQL_ROOT_PASSWORD=
# Usuario administrador de Grafana
GRAFANA_ADMIN_USER=forja
# Contraseña del administrador de Grafana
GRAFANA_ADMIN_PASSWORD=
# Puerto local del Ollama en contenedor (perfil gpu); 11435 para no chocar con un Ollama nativo en 11434
OLLAMA_PUERTO=11435

# --- Cuenta y autenticación (ADR 0009) ---
# Identificador de la clave actual con la que se firman los tokens de acceso (Ed25519); el que quieras, p. ej. 2026-11
FORJA_JWT_KID_ACTUAL=
# Clave privada actual, PKCS#8 en base64 de una línea. Si falta, la aplicación no arranca.
# Genérala con: openssl genpkey -algorithm ed25519 -outform DER | base64 -w0
FORJA_JWT_CLAVE_PRIVADA_ACTUAL=
# Opcional: identificador de la clave anterior, que se sigue aceptando al validar mientras dura la rotación
FORJA_JWT_KID_ANTERIOR=
# Opcional: clave pública anterior, X.509 en base64 de una línea. Sácala de la privada anterior (DER) con:
#   openssl pkey -inform DER -outform DER -pubout -in privada-anterior.der | base64 -w0
FORJA_JWT_CLAVE_PUBLICA_ANTERIOR=
# Opcional: ruta a un archivo con contraseñas filtradas, una por línea. Sin ella no se comprueba ninguna
FORJA_CONTRASENAS_FILTRADAS=
# Origen de la web que puede llamar a la API (CORS), p. ej. https://forja.example. Tauri ya va incluido
FORJA_ORIGEN_WEB=
